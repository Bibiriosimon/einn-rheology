units lj
atom_style bond
read_restart ../equilibrium-000/equilibrium.restart
pair_style lj/expand 2.5
pair_coeff 1 1 1.0 1.0 0.0 2.5
pair_coeff 1 2 3.0 1.0 1.5 2.5
pair_coeff 2 2 1.0 1.0 3.0 1.12
pair_modify shift yes tail no
bond_style harmonic
bond_coeff 1 1000.0 1.0
special_bonds lj 0.0 1.0 1.0
neighbor .4 bin
neigh_modify every 1 delay 0 check yes
timestep 0.001
change_box all triclinic
reset_timestep 0
group polymer type 1
compute bonds all bond/local dist
compute maxbond all reduce max c_bonds inputs local
compute chunks polymer chunk/atom molecule
compute rg polymer gyration/chunk chunks
fix rgout polymer ave/time 100 1 1000 c_rg file flow_rg.txt mode vector
thermo 1000
thermo_style custom step temp pe press vol density c_maxbond
thermo_modify lost error flush yes norm no
compute thermal all temp/deform
compute virial all pressure NULL virial
compute total all pressure thermal
variable eta_virial equal -c_virial[4]/0.5
variable eta_total equal -c_total[4]/0.5
fix flow all deform 0 xy erate 0.5 remap v
fix integrator all nvt/sllod temp 1.0 1.0 .5 integrator legacy peculiar no kick yes tchain 1
fix stress all ave/time 10 100 1000 c_thermal c_virial[4] c_total[4] v_eta_virial v_eta_total c_maxbond file stress_blocks.txt
compute ybin all chunk/atom bin/1d y lower .05 units reduced
fix profile all ave/chunk 10 100 1000 ybin vx density/number file velocity_profile.txt
dump frames all custom 25000 trajectory.lammpstrj id mol type xu yu zu vx vy vz
dump_modify frames sort id
thermo_style custom step temp pe c_virial[4] vol c_maxbond
thermo_modify temp thermal norm no lost error flush yes
run 100000
write_restart final.restart
write_data final.data pair ij
