units lj
atom_style bond
boundary p p p
read_data system.data
bond_style harmonic
bond_coeff 1 1000.0 1.0
special_bonds lj 0.0 1.0 1.0
pair_style soft 4.2
pair_coeff 1 1 10.0 1.1224620483
pair_coeff 1 2 10.0 2.7
pair_coeff 2 2 10.0 4.2
neighbor .4 bin
neigh_modify every 1 delay 0 check yes
timestep .001
velocity all create 1.0 720301 mom yes rot yes dist gaussian
thermo 1000
thermo_style custom step temp pe press vol
thermo_modify norm no
fix soft_eq all nvt temp 1 1 .5
run 10000
pair_coeff 1 1 50.0 1.1224620483
pair_coeff 1 2 50.0 2.7
pair_coeff 2 2 50.0 4.2
run 10000
pair_coeff 1 1 100.0 1.1224620483
pair_coeff 1 2 100.0 2.7
pair_coeff 2 2 100.0 4.2
run 10000
unfix soft_eq
pair_style lj/expand 2.5
pair_coeff 1 1 1.0 1.0 0.0 2.5
pair_coeff 1 2 3.0 1.0 1.5 2.5
pair_coeff 2 2 1.0 1.0 3.0 1.12
pair_modify shift yes tail no
bond_style harmonic
bond_coeff 1 1000.0 1.0
special_bonds lj 0.0 1.0 1.0
neighbor .4 bin
neigh_modify every 1 delay 0 check yes
min_style cg
minimize 1e-9 1e-7 5000 50000
reset_timestep 0
group polymer type 1
compute bonds all bond/local dist
compute maxbond all reduce max c_bonds inputs local
compute chunks polymer chunk/atom molecule
compute rg polymer gyration/chunk chunks
fix rgout polymer ave/time 100 1 1000 c_rg file warm_rg.txt mode vector
thermo 1000
thermo_style custom step temp pe press vol density c_maxbond
thermo_modify lost error flush yes norm no
fix initial all nvt temp 1 1 .5
run 100000
unfix initial
fix dense all npt temp 1 1 .5 iso 0 0 5
run 1000000
unfix dense
write_restart warm.restart
write_data warm.data pair ij
variable end_volume equal vol
variable end_density equal density
print "FINAL_VOLUME ${end_volume}"
print "FINAL_DENSITY ${end_density}"
